# Copy to .env and fill in. Never commit .env.

# Bot token from the Discord developer portal.
DISCORD_BOT_TOKEN=

# Snowflake ID of the existing "Competitor" role (granted by /register).
REGISTERED_ROLE_ID=

# Snowflake ID of the existing "Executive" role (officer-only commands).
OFFICER_ROLE_ID=

# Snowflake ID of the category new team channels are created under.
TEAM_CATEGORY_ID=

# Snowflake ID of the club server. Commands sync to this guild only while
# GUILD_ID is set; leave it blank to sync globally for production rollout.
GUILD_ID=

# Snowflake ID of the channel to post "bot is online/offline" messages
# (and the changelog, when there's a new entry) to. Leave blank to disable
# these announcements entirely.
ANNOUNCEMENT_CHANNEL_ID=

# Directory holding wcrl.db plus its -wal/-shm sidecars. Defaults to "data"
# (relative to the repo locally, or /app inside the container). In
# docker-compose.yml deployments this also picks the host-side mount source
# for the container's data volume — set it here to point persistent storage
# somewhere other than a folder next to the repo (e.g. a mounted disk).
DATA_DIR=./data/
